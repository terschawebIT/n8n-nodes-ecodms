{
	"name": "n8n-nodes-ecodms",
	"version": "1.0.3",
	"description": "ecoDMS-Integration für n8n - Dokumentenmanagement und Archivierung",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"ecodms",
		"dms",
		"document-management",
		"archiving",
		"classification",
		"workflow-automation"
	],
	"license": "MIT",
	"homepage": "https://github.com/terschawebIT/n8n-nodes-ecodms",
	"author": {
		"name": "terschawebIT",
		"email": "info@terschaweb.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/terschawebIT/n8n-nodes-ecodms.git"
	},
	"bugs": {
		"url": "https://github.com/terschawebIT/n8n-nodes-ecodms/issues"
	},
	"engines": {
		"node": ">=20.15",
		"npm": ">=10.0"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"build:watch": "tsc --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run clean && npm run build && npm run lint",
		"test": "jest",
		"dev": "npm run build && npm run test",
		"release": "npm run build && npm run test && git add . && git commit -m 'build: update distribution' && git push && npm publish",
		"quick-fix": "npm run build && git add . && git commit && git push",
		"patch": "npm version patch && npm run build && git add . && git commit -m 'chore: version bump' && git push && npm publish",
		"package": "npm run build && npm pack"
	},
	"files": [
		"dist",
		"index.js"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/EcoDmsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/EcoDMS/EcoDMS.node.js"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@types/node": "^22.0.0",
		"gulp": "^5.0.1",
		"n8n-workflow": "^2.7.0",
		"typescript": "~5.7.0"
	},
	"peerDependencies": {
		"n8n-workflow": "^2.0.0"
	},
	"dependencies": {
		"form-data": "^4.0.5"
	},
	"overrides": {
		"form-data": "^4.0.5",
		"axios": ">=1.12.2"
	}
}
